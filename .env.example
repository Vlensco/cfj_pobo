# Copy this file to .env and fill in real values. Never commit .env.
# Every value below is a placeholder: do not put real secrets in this file.

# ---------------------------------------------------------------
# APP
# ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
VITE_APP_ID=cfj_storefront
# Public origin of the deployed site (used for payment return URLs and webhooks).
APP_URL=http://localhost:3000

# ---------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cfjersey
# Only needed by `pnpm db:init`, which creates the role and database above.
POSTGRES_ADMIN_URL=postgresql://postgres:PASSWORD@localhost:5432/postgres

# ---------------------------------------------------------------
# AUTH  (required in production: the server refuses to sign sessions without JWT_SECRET)
# ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Staff login for /admin/login. Admin login stays disabled while ADMIN_PASSWORD is empty.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cfjersey.com
ADMIN_PASSWORD=

# ---------------------------------------------------------------
# STRIPE
# ---------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---------------------------------------------------------------
# WISE (bank transfer checkout)
# ---------------------------------------------------------------
# Personal API token from Wise > Settings > API tokens (sandbox: https://wise-sandbox.com).
WISE_API_TOKEN=
# sandbox | production
WISE_ENV=sandbox
# Optional: profile that receives payments (detected from the token when empty).
WISE_PROFILE_ID=
# Currencies customers can pay in; the Wise account needs account details for each.
WISE_CURRENCIES=USD,EUR,GBP

# ---------------------------------------------------------------
# NOWPAYMENTS (CRYPTO)
# ---------------------------------------------------------------
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_ENV=sandbox

# ---------------------------------------------------------------
# EXCHANGERATE-API (optional: falls back to a public rate source)
# ---------------------------------------------------------------
EXCHANGERATE_API_KEY=
